<!DOCTYPE html>
<html lang="en">
 <%- include('partials/head') %>
<body>
  <%- include('partials/header') %>

<section class="main-content" style="padding-top: 0;">
</section>

<main class="main-content">
  <section class="personal-gallery">
    
    <% images.forEach(image => { %>


        <div class="personal-gallery__item">
          <img src="/images/personal-gallery/<%= image %>" alt="<%= image %>">
          <p><%= image %></p>
        </div>
      <% }) %>
</section>
</main>

  <%- include("partials/footer") %>
</body>
</html>