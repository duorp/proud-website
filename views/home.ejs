<!DOCTYPE html>
<html lang="en">
 <%- include('partials/head') %>
<body>
<header>
    
    <nav id="navbar">
            <div class="logo">

                <a href="/">Proud Taranat</a>
            </div>
            <div id="hamburger-menu-icon">
                <img src="/images/favicon.svg" alt="Proud Taranat logo" id="site-logo" />
            </div>
    </nav>


</header>
    <div id="hamburger-menu-home">
      <div class="landing__container">
        <div class="landing__text">
        </div>
      </div>
</div>
<main class="main-content">
<section id="navigation">
<ul>
  <a href="https://docs.google.com/document/d/1sO8lZd57u11MrD334T39kIiJx0BL2nNoaOAREdW_bzs/edit?usp=sharing"><li>CV</li></a>
  <a href="/index"><li>Everything</li></a>
</ul>
<p>where i <a target="_blank" href="https://grimshaw.global/">work,</a> what i'm <a href="gallery">making,</a> <a href="mailto:proud.taranat@gmail.com">contact me</a></p>
<p>this website is still under development.</p>
<!-- <div class="colors-container">
  <div class="colors-container__colors" id="white"></div>
  <div class="colors-container__colors" id="black"></div>
  <div class="colors-container__colors" id="gray"></div>
  <div class="colors-container__colors" id="random"></div>


</div>
-->
</section>
  <section class="grid">
  <% projects.forEach(p => { %>
    <article class="card card--<%= p.span %>" >
    <a href="<%= p.type === 'c' ? '/under-construction' : p.type === 'r' ? p.redirect : '/p/' + p.slug %>">
      <div
        class="card__image"
        style="--ratio: <%= p.ratio %>;"
      >
        <div class="card__overlay" <% if (p.type ==='b') { %>style="opacity: 1;"<% } %> >
          <h3><%= p.subtitle %></h3>
        </div>
        <img src="<%= p.image %>"  onerror="this.onerror=null; this.src='/images/godfrey-dadich.gif';">
      </div>
    </a>

      <h3><%= p.title %></h3>
      <div class="card__tags">
        <a href=/index><% p.tags.forEach((tag, i) => { %>
          <span class="tag"><%= tag %></span>
        <% }) %>
        </a>
      </div>
    </article>
  <% }) %>
</section>
</main>

  <%- include("partials/footer") %>
  <script src="/js/sketch2.js"></script>
  <div class="cursor"></div>
</body>
</html>