<!DOCTYPE html>
<html lang="en">
=<%- include('partials/head') %>
<body>
    <%- include('partials/header') %>
<main class="main-content" id="index">
    <section id="tags-container">
        <% tags.forEach(tag => { %>
            <div class="tag"><%= tag %></div>
        <% }) %>
    </section>
    
<section class="project-index">
  <% projects.forEach(p => { %>
    <article class="card" >
    <a href="<%= p.type === 'c' ? '/under-construction' : p.type === 'r' ? p.redirect : '/p/' + p.slug %>">
      <div
        class="card__image"
        style="--ratio: 16/9;"
      >
        <img src="<%= p.image %>"  onerror="this.onerror=null; this.src='/images/godfrey-dadich.gif';">
      </div>
    </a>

      <h2><%= p.title %></h2>
      <div class="card__tags">
        <a href=/index><% p.tags.forEach((tag, i) => { %>
          <span class="tag"><%= tag %></span>
        <% }) %>
        </a>
      </div>
    </article>
  <% }) %>
</section>
</main>
<div class="cursor"></div>
    <%- include('partials/footer') %>
</body>
<script type="module" src="/js/main.js"></script>
</html>

